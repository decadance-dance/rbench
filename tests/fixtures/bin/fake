#!/usr/bin/env python3
"""Fake `claude`, `codex`, `docker`, `gh` and `security` for tests; each name is a symlink to this file.

Environment:
  RBENCH_FAKE_LOG       file that gets one JSON line per call: {"tool", "argv", "stdin", "cwd"},
                        and "env" when RBENCH_FAKE_ENV is set.
  RBENCH_FAKE_ENV       comma-separated variable names; "env" maps each to its value in the
                        call's environment, or null when it is unset.
  RBENCH_FAKE_SCENARIO  JSON object mapping a tool name to its scenario; a tool without one
                        prints nothing and exits 0. Scenario keys, all optional:
                          delay   seconds to sleep before answering
                          stdout  text to print to stdout
                          stdout_for  object mapping an argument to the stdout of a call that
                                  has it, in place of `stdout` (one asset per download)
                          stderr  text to print to stderr (a rate-limit message goes here or in
                                  stdout, as the real CLI prints it)
                          exit    exit code, default 0
                          write_after  object mapping an option to text the call writes to the
                                  file named by the argument after that option, when it has it
                                  (Codex's --output-last-message)
                          crash   true: print what is given, then die by SIGKILL
                          binary  true: write stdout and stderr as bytes, each character
                                  one byte (Latin-1), so "\u00ff" gives the byte 0xff
                          replies a list of scenarios, each with a `match` string; the first
                                  whose `match` is a substring of the space-joined argv answers
                                  instead of the keys above

Stdin is read to the end unless it is a terminal: give the child input or DEVNULL.
"""

import json
import os
import signal
import sys
import time

tool = os.path.basename(sys.argv[0])
stdin = "" if sys.stdin is None or sys.stdin.isatty() else sys.stdin.read()

log = os.environ.get("RBENCH_FAKE_LOG")
if log:
    with open(log, "a", encoding="utf-8") as f:
        call = {"tool": tool, "argv": sys.argv[1:], "stdin": stdin, "cwd": os.getcwd()}
        if names := os.environ.get("RBENCH_FAKE_ENV"):
            call["env"] = {name: os.environ.get(name) for name in names.split(",")}
        f.write(json.dumps(call) + "\n")

scenario = json.loads(os.environ.get("RBENCH_FAKE_SCENARIO") or "{}").get(tool, {})
joined = " ".join(sys.argv[1:])
scenario = next((r for r in scenario.get("replies", []) if r["match"] in joined), scenario)
time.sleep(scenario.get("delay", 0))
by_arg = scenario.get("stdout_for", {})
out = next((by_arg[a] for a in sys.argv[1:] if a in by_arg), scenario.get("stdout", ""))
err = scenario.get("stderr", "")
for option, text in scenario.get("write_after", {}).items():
    if option in sys.argv[1:-1]:
        with open(sys.argv[sys.argv.index(option) + 1], "w", encoding="utf-8") as f:
            f.write(text)
if scenario.get("binary"):
    sys.stdout.buffer.write(out.encode("latin-1"))
    sys.stderr.buffer.write(err.encode("latin-1"))
else:
    sys.stdout.write(out)
    sys.stderr.write(err)
sys.stdout.flush()
sys.stderr.flush()
if scenario.get("crash"):
    os.kill(os.getpid(), signal.SIGKILL)
sys.exit(scenario.get("exit", 0))
